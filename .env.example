# FixMo Supabase Configuration
# Copy this file to .env.local and fill in your actual Supabase credentials.
# Found in: Supabase Dashboard -> Project Settings -> API (or API Keys)

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (safe to include in the client application)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Note for USB development:
# REACT_NATIVE_PACKAGER_HOSTNAME is used for direct phone-to-PC USB tethering
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.108.211

# IMPORTANT SECURITY NOTE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY in your mobile application.
# Service-role keys bypass Row Level Security (RLS) and must never be used on the client.
