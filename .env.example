# FixMo Supabase Configuration
# Replace these with your actual Supabase project credentials.
# Found in: Supabase Dashboard -> Project Settings -> API

# The public URL of your Supabase project (e.g., https://your-project-id.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public Anonymous API key (safe to include in the client app)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note for USB development:
# REACT_NATIVE_PACKAGER_HOSTNAME is used for direct phone-to-PC USB tethering
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.108.211

# IMPORTANT SECURITY NOTE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY in your mobile app.
# Service-role keys bypass Row Level Security (RLS) and must never be in client apps.
